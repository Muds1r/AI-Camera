{
  "name": "ai-camera",
  "version": "1.0.0",
  "description": "AI Camera System - Fullstack FYP",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run test",
    "predev": "npm run check",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "husky": "^9.1.7"
  }
}
