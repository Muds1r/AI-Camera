{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: free ports 3000 & 5000",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "3000,5000 | ForEach-Object { Get-NetTCPConnection -LocalPort $_ -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue } }"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "dev: quick",
      "type": "npm",
      "script": "dev:quick",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "dev: quick (safe)",
      "dependsOn": ["dev: free ports 3000 & 5000", "dev: quick"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
