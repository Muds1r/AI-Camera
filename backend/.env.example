PORT=5000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Postgres pooler (Supabase → Settings → Database)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

FRONTEND_URL=http://localhost:3000

# Auth. Copy the same JWT_ACCESS_SECRET into frontend/.env.local.
JWT_ACCESS_SECRET=replace-with-a-random-string-at-least-32-chars
BCRYPT_ROUNDS=12

SEED_ADMIN_EMAIL=admin@aicamera.local
SEED_ADMIN_PASSWORD=ChangeMe!Admin1
SEED_ADMIN_NAME=Super Admin

# Password reset (forgot password → secondary email on file).
# In development, OTPs print in the backend terminal (SMTP/Resend are ignored unless MAIL_SEND_IN_DEV=true).
APP_NAME=TruckFlow

# Real email in dev: set MAIL_SEND_IN_DEV=true
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords — use that 16-char value as SMTP_PASS
# APP_NAME=TruckFlow
# MAIL_SEND_IN_DEV=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="TruckFlow <you@gmail.com>"
# Optional: RESEND_API_KEY= (used instead of SMTP when set)
