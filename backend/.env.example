PORT=5000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Postgres pooler (Supabase → Settings → Database)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

FRONTEND_URL=http://localhost:3000

# Auth. Copy the same JWT_ACCESS_SECRET into frontend/.env.local.
JWT_ACCESS_SECRET=replace-with-a-random-string-at-least-32-chars
BCRYPT_ROUNDS=12

SEED_ADMIN_EMAIL=admin@aicamera.local
SEED_ADMIN_PASSWORD=ChangeMe!Admin1
SEED_ADMIN_NAME=Super Admin

# Password reset (forgot password → secondary email on file).
# Prefer Resend. If neither Resend nor SMTP is set in development, new passwords print in the backend console.
APP_NAME=TruckFlow

# Optional legacy SMTP (used only when RESEND_API_KEY is unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="TruckFlow <your-sender@gmail.com>"
