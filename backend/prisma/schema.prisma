generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CameraStatus {
  online
  offline
  error
}

enum AlertSeverity {
  info
  warning
  critical
}

enum Role {
  employee
  dataview
  hr
  finance
  super_admin
}

enum EmploymentStatus {
  active
  resigned
}

enum ShiftKind {
  day
  night
}

enum MedicalRequestStatus {
  pending
  approved
  rejected
}

enum NotificationKind {
  request_submitted
  request_approved
  request_rejected
}

enum AttendanceStatus {
  present
  absent
  late
  half_day
}

enum HolidayKind {
  gazetted
  general_off
}

enum BenefitKind {
  medical
  opd
}

model Camera {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  location    String?
  stream_url  String?
  status      CameraStatus @default(offline)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  detections  Detection[]
  alerts      Alert[]

  @@map("cameras")
}

model Detection {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  camera_id     String   @db.Uuid
  label         String
  confidence    Float
  bounding_box  Json?    @db.JsonB
  snapshot_url  String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  camera        Camera   @relation(fields: [camera_id], references: [id], onDelete: Cascade)
  alerts        Alert[]

  @@index([camera_id])
  @@index([created_at(sort: Desc)])
  @@map("detections")
}

model Alert {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  camera_id     String?       @db.Uuid
  detection_id  String?       @db.Uuid
  severity      AlertSeverity @default(info)
  message       String
  is_read       Boolean       @default(false)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  camera        Camera?       @relation(fields: [camera_id], references: [id], onDelete: SetNull)
  detection     Detection?    @relation(fields: [detection_id], references: [id], onDelete: SetNull)

  @@index([camera_id])
  @@index([created_at(sort: Desc)])
  @@map("alerts")
}

model Company {
  id           String   @id @default("default")
  name         String   @default("TruckFlow")
  logo_url     String?
  weekend_days String   @default("0")
  work_start   String   @default("09:00")
  work_end     String   @default("17:00")
  night_start  String   @default("21:00")
  night_end    String   @default("05:00")
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("company")
}

model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String   @unique
  password_hash   String
  full_name       String
  role            Role     @default(employee)
  phone                    String?
  secondary_email          String?
  address                  String?
  id_card_number           String?   @unique
  date_of_birth            DateTime? @db.Date
  gender                   String?
  blood_group              String?
  emergency_contact_name   String?
  emergency_contact_phone  String?
  joined_on                DateTime? @db.Date
  info                     String?
  avatar_url      String?
  department      String?
  designation     String?
  salary_basic    Float    @default(0)
  salary_allowance Float   @default(0)
  salary_deduction Float   @default(0)
  medical_limit   Float    @default(0)
  opd_limit       Float    @default(0)
  clock_enabled   Boolean  @default(true)
  login_enabled   Boolean  @default(true)
  employee_code   String?  @unique
  employment_status EmploymentStatus @default(active)
  left_on         DateTime? @db.Date
  shift           ShiftKind @default(day)
  password_changed_at DateTime? @db.Timestamptz(6)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  refresh_tokens     RefreshToken[]
  attendance         Attendance[]
  attendance_corrections AttendanceCorrection[] @relation("AttendanceCorrections")
  reviewed_attendance    AttendanceCorrection[] @relation("ReviewedAttendanceCorrections")
  medical_requests   MedicalRequest[]         @relation("MedicalRequests")
  submitted_medical   MedicalRequest[]        @relation("SubmittedMedicalRequests")
  reviewed_requests  MedicalRequest[]         @relation("ReviewedMedicalRequests")
  leave_balances     LeaveBalance[]
  leave_requests     LeaveRequest[]           @relation("LeaveRequests")
  reviewed_leave     LeaveRequest[]           @relation("ReviewedLeave")
  profile_requests   ProfileUpdateRequest[]   @relation("ProfileRequests")
  reviewed_profiles  ProfileUpdateRequest[]   @relation("ReviewedProfiles")
  overtime_requests  OvertimeRequest[]        @relation("OvertimeRequests")
  reviewed_overtime  OvertimeRequest[]        @relation("ReviewedOvertime")
  audit_logs         AuditLog[]
  notifications      Notification[]
  policies           Policy[]
  announcements      Announcement[]
  login_events       LoginEvent[]
  salary_changes     SalaryChange[]
  password_resets    PasswordReset[]

  @@index([role])
  @@index([is_active])
  @@map("users")
}

model LoginEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?  @db.Uuid
  email      String
  event      String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@map("login_events")
}

model PasswordReset {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  code_hash  String
  token_hash String?   @unique
  attempts   Int       @default(0)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@map("password_resets")
}

model SalaryChange {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String   @db.Uuid
  salary_basic      Float
  salary_allowance  Float
  salary_deduction  Float
  actor_id          String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@map("salary_changes")
}

model RefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique
  family_id   String    @db.Uuid
  expires_at  DateTime  @db.Timestamptz(6)
  remember_me Boolean   @default(false)
  revoked_at  DateTime? @db.Timestamptz(6)
  replaced_by String?   @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@map("refresh_tokens")
}

model Attendance {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String           @db.Uuid
  work_date  DateTime         @db.Date
  clock_in   DateTime?        @db.Timestamptz(6)
  clock_out  DateTime?        @db.Timestamptz(6)
  status     AttendanceStatus @default(present)
  note       String?
  created_at DateTime         @default(now()) @db.Timestamptz(6)
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, work_date])
  @@index([user_id])
  @@index([work_date])
  @@map("attendance")
}

model AttendanceCorrection {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String               @db.Uuid
  work_date        DateTime             @db.Date
  requested_status AttendanceStatus
  clock_in         DateTime?            @db.Timestamptz(6)
  clock_out        DateTime?            @db.Timestamptz(6)
  reason           String
  status           MedicalRequestStatus @default(pending)
  review_note      String?
  reviewed_by      String?              @db.Uuid
  reviewed_at      DateTime?            @db.Timestamptz(6)
  created_at       DateTime             @default(now()) @db.Timestamptz(6)
  updated_at       DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  requester        User                 @relation("AttendanceCorrections", fields: [user_id], references: [id], onDelete: Cascade)
  reviewer         User?                @relation("ReviewedAttendanceCorrections", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@map("attendance_corrections")
}

model Holiday {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  holiday_on DateTime    @db.Date
  name       String
  kind       HolidayKind
  created_at DateTime    @default(now()) @db.Timestamptz(6)

  @@unique([holiday_on])
  @@map("holidays")
}

model LeaveType {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String         @unique
  name        String
  default_days Int           @default(0)
  is_paid     Boolean        @default(true)
  is_active   Boolean        @default(true)
  balances    LeaveBalance[]
  requests    LeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  leave_type_id String    @db.Uuid
  allocated     Float     @default(0)
  used          Float     @default(0)
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  leave_type    LeaveType @relation(fields: [leave_type_id], references: [id], onDelete: Cascade)

  @@unique([user_id, leave_type_id])
  @@map("leave_balances")
}

model LeaveRequest {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String               @db.Uuid
  leave_type_id String               @db.Uuid
  start_date    DateTime             @db.Date
  end_date      DateTime             @db.Date
  days          Float
  reason        String
  status        MedicalRequestStatus @default(pending)
  review_note   String?
  reviewed_by   String?              @db.Uuid
  reviewed_at   DateTime?            @db.Timestamptz(6)
  created_at    DateTime             @default(now()) @db.Timestamptz(6)
  updated_at    DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  requester     User                 @relation("LeaveRequests", fields: [user_id], references: [id], onDelete: Cascade)
  reviewer      User?                @relation("ReviewedLeave", fields: [reviewed_by], references: [id], onDelete: SetNull)
  leave_type    LeaveType            @relation(fields: [leave_type_id], references: [id])

  @@index([user_id])
  @@index([status])
  @@map("leave_requests")
}

model OvertimeRequest {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String               @db.Uuid
  work_date   DateTime             @db.Date
  hours       Float
  reason      String
  status      MedicalRequestStatus @default(pending)
  review_note String?
  reviewed_by String?              @db.Uuid
  reviewed_at DateTime?            @db.Timestamptz(6)
  created_at  DateTime             @default(now()) @db.Timestamptz(6)
  updated_at  DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  requester   User                 @relation("OvertimeRequests", fields: [user_id], references: [id], onDelete: Cascade)
  reviewer    User?                @relation("ReviewedOvertime", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@index([work_date])
  @@map("overtime_requests")
}

model ProfileUpdateRequest {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String               @db.Uuid
  changes     Json
  status      MedicalRequestStatus @default(pending)
  review_note String?
  reviewed_by String?              @db.Uuid
  reviewed_at DateTime?            @db.Timestamptz(6)
  created_at  DateTime             @default(now()) @db.Timestamptz(6)
  updated_at  DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  requester   User                 @relation("ProfileRequests", fields: [user_id], references: [id], onDelete: Cascade)
  reviewer    User?                @relation("ReviewedProfiles", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@map("profile_update_requests")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id    String?  @db.Uuid
  action      String
  target_type String
  target_id   String?
  detail      String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  actor       User?    @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([created_at(sort: Desc)])
  @@index([actor_id])
  @@map("audit_logs")
}

model MedicalRequest {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String               @db.Uuid
  kind         BenefitKind          @default(medical)
  amount       Float                @default(0)
  reason       String
  document_url String?
  submitted_by String?              @db.Uuid
  status      MedicalRequestStatus @default(pending)
  review_note String?
  reviewed_by String?              @db.Uuid
  reviewed_at DateTime?            @db.Timestamptz(6)
  created_at  DateTime             @default(now()) @db.Timestamptz(6)
  updated_at  DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  requester   User                 @relation("MedicalRequests", fields: [user_id], references: [id], onDelete: Cascade)
  submitter   User?                @relation("SubmittedMedicalRequests", fields: [submitted_by], references: [id], onDelete: SetNull)
  reviewer    User?                @relation("ReviewedMedicalRequests", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([status])
  @@map("medical_requests")
}

model Policy {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  body       String
  created_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  author     User?    @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([created_at(sort: Desc)])
  @@map("policies")
}

model Announcement {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  body       String              @default("")
  created_by String?             @db.Uuid
  created_at DateTime            @default(now()) @db.Timestamptz(6)
  updated_at DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  author     User?               @relation(fields: [created_by], references: [id], onDelete: SetNull)
  images     AnnouncementImage[]

  @@index([created_at(sort: Desc)])
  @@map("announcements")
}

model AnnouncementImage {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  announcement_id String       @db.Uuid
  url             String
  position        Int
  announcement    Announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade)

  @@index([announcement_id, position])
  @@map("announcement_images")
}

model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String           @db.Uuid
  kind       NotificationKind
  title      String
  body       String
  href       String
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now()) @db.Timestamptz(6)
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)])
  @@index([user_id, is_read])
  @@map("notifications")
}
